# CLIENT FINDER SVC - Environment Configuration

# Database Configuration
# Options: sqlite, postgresql, mongodb
DATABASE_TYPE=mongodb

# MongoDB Connection URI (Format: mongodb://username:password@host:port/?authSource=admin)
MONGODB_URI=mongodb://CLIENT_FINDER:YOUR_PASSWORD@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=client_finder

# SQL Database URL (Alternative for SQLite/PostgreSQL)
# DATABASE_URL=sqlite:///data/client_finder.db
# DATABASE_URL=postgresql://user:password@localhost:5432/client_finder

# LLM & AI Service API Keys (Optional - heuristics used when empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Multi-Channel Notification Webhooks
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Pipeline & Scraping Tuning
MIN_OPPORTUNITY_SCORE=70.0
COLLECTION_INTERVAL_SECONDS=3600
RATE_LIMIT_DELAY_SECONDS=2.0
