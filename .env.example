# ==============================================================================
# CLIENT FINDER SVC — Production Environment Variables Configuration Template
# Copy this file to .env and customize the values for your deployment.
# ==============================================================================

# Application & Environment
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
JWT_SECRET_KEY=change_this_to_a_super_secret_jwt_signing_key_at_least_32_chars_long

# Primary SQL Database (PostgreSQL 16)
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg2://clientfinder:SecureDbPass123!@postgres:5432/clientfinder_db
POSTGRES_USER=clientfinder
POSTGRES_PASSWORD=SecureDbPass123!
POSTGRES_DB=clientfinder_db

# MongoDB Hybrid Store (Optional / Fallback)
MONGO_URI=mongodb://mongo:27017/clientfinder_raw
MONGO_DATABASE=clientfinder_raw

# Redis Cache & Message Broker (Optional / Celery & Rate Limiting)
REDIS_URL=redis://redis:6379/0

# AI Provider API Keys (Gemini / Anthropic / OpenAI)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Multi-Channel Dispatcher Webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO_EMAIL=

# Pipeline Scheduler Configuration
SCHEDULE_INTERVAL_MINUTES=60
AUTO_OUTREACH_ENABLED=true
SCORE_THRESHOLD_ALERT=80
